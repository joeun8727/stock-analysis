# cp .env.example .env 한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=stock_analysis
MYSQL_USER=stock
MYSQL_PASSWORD=change-me

# 백엔드가 붙을 DB (compose 네트워크 안에서는 호스트가 서비스명 mysql)
DB_HOST=mysql
DB_PORT=3306

# 브라우저에서 백엔드를 호출하는 주소 — 컨테이너 내부가 아니라 사용자 PC 기준
NEXT_PUBLIC_API_BASE=http://localhost:8080

# compose가 포트를 열 주소. 기본은 이 PC에서만 접속 가능(127.0.0.1)입니다.
# 실투자 API에는 인증이 없어서 /api/live/arm 한 번이면 실계좌 주문이 시작될 수 있으므로,
# 0.0.0.0으로 바꾸면 같은 네트워크의 누구나 그걸 부를 수 있습니다. 바꾸기 전에 인증을 먼저 붙이세요.
BIND_ADDR=127.0.0.1

# ── 실투자 (한국투자증권) ─────────────────────────────────────────────
# 비워두면 실투자 기능은 그냥 동작하지 않습니다. 백테스트에는 아무 영향이 없습니다.
#
# DRY_RUN: 판단·기록만 하고 주문을 보내지 않음 (기본값, 여기서 시작하세요)
# PAPER:   모의투자 서버로 실제 주문
# REAL:    실계좌로 진짜 주문 — 모의투자에서 충분히 확인한 뒤에만
KIS_MODE=DRY_RUN
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

# 모의투자 서버가 국내선물 시세를 안 줄 때만 채우세요.
# 장전 선물 추세가 곧 매수 방향이라, 시세만 실전 앱키로 받고 주문은 모의로 낼 수 있게 분리해뒀습니다.
KIS_QUOTE_APP_KEY=
KIS_QUOTE_APP_SECRET=
