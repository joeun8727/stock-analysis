# cp .env.example .env 한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=stock_analysis
MYSQL_USER=stock
MYSQL_PASSWORD=change-me

# 백엔드가 붙을 DB (compose 네트워크 안에서는 호스트가 서비스명 mysql)
DB_HOST=mysql
DB_PORT=3306

# 브라우저에서 백엔드를 호출하는 주소 — 컨테이너 내부가 아니라 사용자 PC 기준
NEXT_PUBLIC_API_BASE=http://localhost:8080
